---
import { profile } from "../data/profile";

const links = [
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Education", href: "#education" },
  { label: "Skills", href: "#skills" },
];
---

<nav
  class="sticky top-0 z-50 border-b border-[var(--color-rule)] bg-[var(--color-bone)]/85 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-(--container-prose) items-center justify-between px-6 py-4"
  >
    <a
      href="#top"
      class="text-sm font-medium tracking-tight text-[var(--color-ink)]"
    >
      {profile.name}
    </a>
    <ul class="hidden gap-6 text-sm text-[var(--color-muted)] sm:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors hover:text-[var(--color-ink)]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
