---
import { profile } from "../data/profile";
---

<nav
  class="sticky top-0 z-50 border-b border-[var(--color-rule)] bg-[var(--color-bone)]/85 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-(--container-prose) items-center justify-between px-6 py-3.5"
  >
    <a
      href="#top"
      class="text-sm font-medium tracking-tight text-[var(--color-ink)]"
    >
      {profile.name}
    </a>
    <div class="flex items-center gap-5 text-sm text-[var(--color-muted)]">
      <a href="#timeline" class="hover:text-[var(--color-ink)]">Timeline</a>
      <a href="#skills" class="hover:text-[var(--color-ink)]">Skills</a>
      <a
        href={profile.resumeUrl}
        class="text-[var(--color-ink)] underline-offset-4 hover:underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        Resume
      </a>
    </div>
  </div>
</nav>
