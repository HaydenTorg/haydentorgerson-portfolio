---
import { profile } from "../data/profile";
---

<header id="top" class="relative">
  <div
    class="relative h-56 w-full overflow-hidden bg-[var(--color-ink)]/5 sm:h-72"
  >
    <img
      src={profile.hero}
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
      class="h-full w-full object-cover opacity-90"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-transparent to-[var(--color-bone)]"
    >
    </div>
  </div>

  <div class="mx-auto -mt-16 max-w-(--container-prose) px-6 sm:-mt-20">
    <div
      class="size-32 overflow-hidden rounded-full border-4 border-[var(--color-bone)] bg-[var(--color-bone)] shadow-sm sm:size-40"
    >
      <img
        src={profile.faceshot}
        alt={`Portrait of ${profile.name}`}
        width="160"
        height="160"
        class="h-full w-full object-cover"
      />
    </div>

    <div class="mt-6">
      <h1
        class="text-4xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-5xl"
      >
        {profile.name}
      </h1>
      <p class="mt-3 text-base text-[var(--color-muted)] sm:text-lg">
        {profile.tagline}
      </p>
      <p class="mt-1 text-sm text-[var(--color-muted)]">
        {profile.location}
      </p>
    </div>
  </div>
</header>
