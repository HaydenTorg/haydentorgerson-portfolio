---
import type { TimelineEntry as Entry } from "../data/timeline";

interface Props {
  entry: Entry;
  index: number;
}

const { entry, index } = Astro.props;
const isLeft = index % 2 === 0;

const contentSide = isLeft
  ? "sm:pr-[calc(50%+1.5rem)] sm:text-right"
  : "sm:pl-[calc(50%+1.5rem)]";

const kindLabel = entry.kind === "education" ? "Education" : "Experience";
const delayMs = Math.min(index * 80, 400);
---

<li class="relative pb-8 last:pb-0">
  <span
    class="absolute top-4 left-2 size-3 -translate-x-1/2 rounded-full bg-[var(--color-ink)] ring-4 ring-[var(--color-bone)] sm:left-1/2"
    aria-hidden="true"
  ></span>

  <div class={`pl-8 sm:pl-0 ${contentSide}`}>
    <div
      data-reveal
      style={`transition-delay: ${delayMs}ms`}
      class="inline-block rounded-xl border border-[var(--color-rule)] bg-[var(--color-card)] px-5 py-4 text-left"
    >
      <div
        class="flex items-baseline gap-2 text-xs tracking-[0.14em] text-[var(--color-muted)] uppercase"
      >
        <span>{entry.year}</span>
        <span aria-hidden="true">·</span>
        <span>{kindLabel}</span>
      </div>

      <h3 class="mt-2 text-base font-medium text-[var(--color-ink)] sm:text-lg">
        {entry.title}
      </h3>

      <div class="mt-0.5 text-sm text-[var(--color-muted)]">
        {entry.company}{entry.location ? ` · ${entry.location}` : ""}
      </div>

      {
        entry.description && (
          <p class="mt-2.5 text-sm leading-relaxed text-[var(--color-ink)]/80">
            {entry.description}
          </p>
        )
      }
    </div>
  </div>
</li>
