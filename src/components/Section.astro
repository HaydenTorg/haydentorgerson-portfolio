---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="mx-auto max-w-(--container-prose) px-6 py-12 sm:py-16">
  <h2
    class="mb-8 text-xs font-medium tracking-[0.18em] text-[var(--color-muted)] uppercase"
  >
    {title}
  </h2>
  <slot />
</section>
