---
import { profile } from "../data/profile";

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-rule)]">
  <div
    class="mx-auto flex max-w-(--container-prose) flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="text-sm text-[var(--color-muted)]">
      © {year} {profile.name}
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      {
        profile.socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-ink)] underline-offset-4 hover:underline"
          >
            {social.label}
          </a>
        ))
      }
      <a
        href={profile.resumeUrl}
        download
        class="text-[var(--color-ink)] underline-offset-4 hover:underline"
      >
        Download Resume (PDF)
      </a>
    </div>
  </div>
</footer>
