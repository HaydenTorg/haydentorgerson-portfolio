---
import { profile } from "../data/profile";
import { timeline } from "../data/timeline";

const experience = timeline.filter((e) => e.kind === "experience");
const education = timeline.filter((e) => e.kind === "education");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile.name} — Resume</title>
    <style>
      @page {
        size: letter;
        margin: 0;
      }
      * {
        box-sizing: border-box;
      }
      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 10.5pt;
        line-height: 1.4;
        color: #000;
        margin: 0;
        padding: 0.6in 0.7in;
      }
      h1 {
        font-size: 22pt;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin: 0 0 4px;
      }
      .contact {
        font-size: 10pt;
        color: #333;
        margin-bottom: 12px;
      }
      hr {
        border: 0;
        border-top: 1px solid #000;
        margin: 6px 0 14px;
      }
      h2 {
        font-size: 11.5pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        margin: 18px 0 8px;
        padding-bottom: 3px;
        border-bottom: 1px solid #888;
      }
      p {
        margin: 0;
      }
      .summary {
        font-size: 10.5pt;
        line-height: 1.5;
      }
      .entry {
        margin: 0 0 12px;
      }
      .entry:last-child {
        margin-bottom: 0;
      }
      .entry-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
      }
      .entry-title {
        font-weight: 700;
        font-size: 11pt;
      }
      .entry-date {
        font-size: 10pt;
        color: #333;
        white-space: nowrap;
      }
      .entry-sub {
        font-style: italic;
        font-size: 10pt;
        color: #444;
        margin: 1px 0 4px;
      }
      .entry-desc {
        font-size: 10pt;
        line-height: 1.45;
      }
      .skills {
        font-size: 10pt;
      }
    </style>
  </head>
  <body>
    <h1>{profile.name}</h1>
    <div class="contact">
      {profile.location} · {profile.email} · linkedin.com/in/hayden-torgerson
      · haydentorgerson.com
    </div>

    <hr />

    <h2>Summary</h2>
    <p class="summary">{profile.bio}</p>

    <h2>Experience</h2>
    {
      experience.map((entry) => (
        <div class="entry">
          <div class="entry-row">
            <span class="entry-title">
              {entry.title}
              {entry.company ? `, ${entry.company}` : ""}
            </span>
            <span class="entry-date">{entry.year}</span>
          </div>
          {entry.location && <div class="entry-sub">{entry.location}</div>}
          <p class="entry-desc">{entry.description}</p>
        </div>
      ))
    }

    <h2>Education</h2>
    {
      education.map((entry) => (
        <div class="entry">
          <div class="entry-row">
            <span class="entry-title">
              {entry.title}
              {entry.company ? `, ${entry.company}` : ""}
            </span>
            <span class="entry-date">{entry.year}</span>
          </div>
          {entry.location && <div class="entry-sub">{entry.location}</div>}
          <p class="entry-desc">{entry.description}</p>
        </div>
      ))
    }

    <h2>Skills</h2>
    <div class="skills">{profile.skills.join(" · ")}</div>
  </body>
</html>
