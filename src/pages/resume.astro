---
import { profile } from "../data/profile";
import { timeline } from "../data/timeline";

const experience = timeline.filter((e) => e.kind === "experience");
const education = timeline.filter((e) => e.kind === "education");
const linkedinHandle = profile.socials.find((s) => s.label === "LinkedIn");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile.name} — Resume</title>
    <meta name="description" content={`Resume of ${profile.name}.`} />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <style>
      :root {
        --ink: #111111;
        --muted: #555555;
        --rule: #cccccc;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        color: var(--ink);
        font-family:
          "Inter",
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          "Helvetica Neue",
          Arial,
          sans-serif;
        font-feature-settings: "cv11", "ss01";
        -webkit-font-smoothing: antialiased;
        font-size: 10.5pt;
        line-height: 1.45;
      }
      .page {
        max-width: 7.3in;
        margin: 0 auto;
        padding: 0.55in 0.55in 0.5in;
      }
      header.head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.5rem;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--ink);
      }
      h1 {
        font-size: 24pt;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0;
        line-height: 1.05;
      }
      .tagline {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 10pt;
      }
      .contact {
        font-size: 9.5pt;
        text-align: right;
        color: var(--ink);
        line-height: 1.55;
      }
      .contact a {
        color: var(--ink);
        text-decoration: none;
      }
      .contact a:hover {
        text-decoration: underline;
      }
      section {
        margin-top: 22px;
      }
      h2 {
        font-size: 8.5pt;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-weight: 600;
        color: var(--muted);
        margin: 0 0 10px;
      }
      .summary {
        margin: 0;
        font-size: 10.5pt;
        line-height: 1.55;
      }
      .entry {
        display: grid;
        grid-template-columns: 1.05in 1fr;
        gap: 14px;
        padding: 8px 0;
        border-top: 1px solid var(--rule);
      }
      .entry:first-of-type {
        border-top: none;
      }
      .entry .year {
        font-size: 9.5pt;
        color: var(--muted);
        padding-top: 1px;
      }
      .entry h3 {
        margin: 0;
        font-size: 11pt;
        font-weight: 600;
        line-height: 1.3;
      }
      .entry .meta {
        margin: 2px 0 4px;
        font-size: 9.5pt;
        color: var(--muted);
      }
      .entry p {
        margin: 0;
        font-size: 10pt;
        line-height: 1.5;
        color: #222;
      }
      .skills {
        font-size: 10pt;
        line-height: 1.7;
      }
      .skills span:not(:last-child)::after {
        content: " · ";
        color: var(--muted);
      }

      @page {
        size: letter;
        margin: 0;
      }
      @media print {
        body {
          font-size: 10.5pt;
        }
        a {
          color: var(--ink) !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="head">
        <div>
          <h1>{profile.name}</h1>
          <p class="tagline">{profile.tagline}</p>
        </div>
        <div class="contact">
          <div>{profile.location}</div>
          <div><a href={`mailto:${profile.email}`}>{profile.email}</a></div>
          {
            linkedinHandle && (
              <div>
                <a href={linkedinHandle.href}>linkedin.com/in/hayden-torgerson</a>
              </div>
            )
          }
          <div><a href="https://haydentorgerson.com">haydentorgerson.com</a></div>
        </div>
      </header>

      <section>
        <h2>Summary</h2>
        <p class="summary">{profile.bio}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {
          experience.map((entry) => (
            <div class="entry">
              <div class="year">{entry.year}</div>
              <div>
                <h3>
                  {entry.title}
                  {entry.company ? <> — {entry.company}</> : null}
                </h3>
                {entry.location && <div class="meta">{entry.location}</div>}
                <p>{entry.description}</p>
              </div>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Education</h2>
        {
          education.map((entry) => (
            <div class="entry">
              <div class="year">{entry.year}</div>
              <div>
                <h3>
                  {entry.title}
                  {entry.company ? <> — {entry.company}</> : null}
                </h3>
                {entry.location && <div class="meta">{entry.location}</div>}
                <p>{entry.description}</p>
              </div>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Skills</h2>
        <div class="skills">
          {profile.skills.map((s) => <span>{s}</span>)}
        </div>
      </section>
    </div>
  </body>
</html>
